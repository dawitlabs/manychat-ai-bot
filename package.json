{
  "name": "manychat-ai-bot",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:api": "pnpm --filter @manychat-bot/api dev",
    "dev:web": "pnpm --filter @manychat-bot/web dev",
    "dev:admin": "pnpm --filter @manychat-bot/admin dev",
    "build": "pnpm --filter @manychat-bot/web build && pnpm --filter @manychat-bot/admin build"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  }
}
